<?xml version="1.0" encoding="UTF-8"?>
<!--
  KDE/Kate-format syntax definition for the Rocq/Coq proof assistant (Gallina).

  Provenance: written from scratch for this site; no Coq definition exists in
  KDE syntax-highlighting upstream (checked invent.kde.org/frameworks/
  syntax-highlighting, master, 2026-08). XML structure modelled on KDE's
  haskell.xml and ocaml.xml (LGPL), used only as structural references.

  Loaded at build time by Skylighting.Parser.parseSyntaxDefinition and used to
  highlight ```coq and ```rocq fenced code blocks in blog posts.

  Coverage: vernacular commands, Gallina term keywords, common tactics, sorts
  and base types, nested (* ... *) comments (doc comments (** ... *) included),
  strings with backslash escapes, decimal/hex integers, operator runs.
  Type/Set/Prop/SProp live in the "sorts and base types" list only (one home
  per word). Primes are word characters, so x' / foo'' stay one identifier.

  License: MIT
-->
<language name="Coq"
          section="Scientific"
          version="1"
          kateSyntaxVersion="5.53"
          extensions="*.v"
          mimetype="text/x-coq"
          author="Yao Li"
          license="MIT">
  <highlighting>
    <list name="vernacular">
      <item>Theorem</item>
      <item>Lemma</item>
      <item>Corollary</item>
      <item>Remark</item>
      <item>Fact</item>
      <item>Proposition</item>
      <item>Definition</item>
      <item>Let</item>
      <item>Inductive</item>
      <item>CoInductive</item>
      <item>Variant</item>
      <item>Record</item>
      <item>Structure</item>
      <item>Class</item>
      <item>Instance</item>
      <item>Fixpoint</item>
      <item>CoFixpoint</item>
      <item>Function</item>
      <item>Program</item>
      <item>Example</item>
      <item>Axiom</item>
      <item>Conjecture</item>
      <item>Parameter</item>
      <item>Parameters</item>
      <item>Variable</item>
      <item>Variables</item>
      <item>Hypothesis</item>
      <item>Hypotheses</item>
      <item>Context</item>
      <item>Section</item>
      <item>Module</item>
      <item>End</item>
      <item>Proof</item>
      <item>Qed</item>
      <item>Defined</item>
      <item>Admitted</item>
      <item>Abort</item>
      <item>Require</item>
      <item>Import</item>
      <item>Export</item>
      <item>Open</item>
      <item>Close</item>
      <item>Scope</item>
      <item>Delimit</item>
      <item>Bind</item>
      <item>Notation</item>
      <item>Infix</item>
      <item>Reserved</item>
      <item>Arguments</item>
      <item>Canonical</item>
      <item>Existing</item>
      <item>Global</item>
      <item>Local</item>
      <item>Unset</item>
      <item>Check</item>
      <item>Print</item>
      <item>Eval</item>
      <item>Compute</item>
      <item>Search</item>
      <item>SearchAbout</item>
      <item>Locate</item>
      <item>About</item>
      <item>Ltac</item>
      <item>Ltac2</item>
    </list>
    <list name="term keywords">
      <item>forall</item>
      <item>exists</item>
      <item>fun</item>
      <item>fix</item>
      <item>cofix</item>
      <item>match</item>
      <item>with</item>
      <item>end</item>
      <item>if</item>
      <item>then</item>
      <item>else</item>
      <item>return</item>
      <item>as</item>
      <item>in</item>
      <item>let</item>
      <item>where</item>
      <item>struct</item>
      <item>wf</item>
      <item>measure</item>
    </list>
    <list name="tactics">
      <item>intros</item>
      <item>intro</item>
      <item>apply</item>
      <item>eapply</item>
      <item>exact</item>
      <item>assumption</item>
      <item>reflexivity</item>
      <item>simpl</item>
      <item>cbn</item>
      <item>cbv</item>
      <item>hnf</item>
      <item>rewrite</item>
      <item>erewrite</item>
      <item>induction</item>
      <item>destruct</item>
      <item>case</item>
      <item>split</item>
      <item>left</item>
