      <item>generalize</item>
      <item>pose</item>
      <item>remember</item>
      <item>unfold</item>
      <item>fold</item>
      <item>change</item>
      <item>pattern</item>
      <item>assert</item>
      <item>enough</item>
      <item>specialize</item>
      <item>clear</item>
      <item>red</item>
      <item>f_equal</item>
      <item>extensionality</item>
      <item>tauto</item>
      <item>intuition</item>
      <item>firstorder</item>
      <item>eauto</item>
      <item>auto</item>
