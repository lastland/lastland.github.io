    </list>
    <list name="sorts and base types">
      <item>Type</item>
      <item>Set</item>
      <item>Prop</item>
      <item>SProp</item>
      <item>nat</item>
      <item>bool</item>
      <item>option</item>
      <item>list</item>
      <item>unit</item>
      <item>sum</item>
      <item>and</item>
      <item>or</item>
      <item>not</item>
      <item>True</item>
      <item>False</item>
      <item>Some</item>
      <item>None</item>
      <item>nil</item>
      <item>cons</item>
    </list>
    <contexts>
      <context attribute="Normal Text" lineEndContext="#stay" name="Normal">
        <Detect2Chars attribute="Comment" context="Comment" char="(" char1="*" beginRegion="Comment"/>
        <DetectChar attribute="String" context="String" char="&quot;"/>
        <!-- multi-word command: keyword rules only match single words -->
        <StringDetect attribute="Keyword" context="#stay" String="Tactic Notation"/>
        <keyword attribute="Keyword" context="#stay" String="vernacular"/>
        <keyword attribute="Keyword" context="#stay" String="term keywords"/>
        <keyword attribute="Tactic" context="#stay" String="tactics"/>
        <keyword attribute="Sort" context="#stay" String="sorts and base types"/>
        <RegExpr attribute="Number" context="#stay" String="0[xX][0-9a-fA-F]+"/>
        <Int attribute="Number" context="#stay"/>
        <RegExpr attribute="Operator" context="#stay" String="[-+*/=&lt;&gt;@|^~?!.;:,$%#&amp;\\(){}\[\]]+"/>
      </context>
      <!-- (* ... *) comments nest; (** ... *) doc comments share this style.
           Strings inside comments must be well-formed, so "..." is tracked. -->
      <context attribute="Comment" lineEndContext="#stay" name="Comment">
        <Detect2Chars attribute="Comment" context="#pop" char="*" char1=")" endRegion="Comment"/>
        <Detect2Chars attribute="Comment" context="Comment" char="(" char1="*" beginRegion="Comment"/>
        <DetectChar attribute="String" context="String" char="&quot;"/>
        <DetectSpaces attribute="Comment"/>
        <DetectIdentifier attribute="Comment"/>
      </context>
      <context attribute="String" lineEndContext="#stay" name="String">
        <DetectChar attribute="String" context="#pop" char="&quot;"/>
        <RegExpr attribute="String" context="#stay" String="\\."/>
      </context>
    </contexts>
    <itemDatas>
      <itemData name="Normal Text" defStyleNum="dsNormal" spellChecking="false"/>
      <itemData name="Keyword" defStyleNum="dsKeyword" spellChecking="false"/>
      <itemData name="Tactic" defStyleNum="dsBuiltIn" spellChecking="false"/>
      <itemData name="Sort" defStyleNum="dsDataType" spellChecking="false"/>
      <itemData name="Operator" defStyleNum="dsOperator" spellChecking="false"/>
      <itemData name="Number" defStyleNum="dsDecVal" spellChecking="false"/>
      <itemData name="String" defStyleNum="dsString"/>
      <itemData name="Comment" defStyleNum="dsComment"/>
    </itemDatas>
  </highlighting>
  <general>
    <comments>
      <comment name="multiLine" start="(*" end="*)" region="Comment"/>
    </comments>
    <!-- Coq identifiers may carry primes (x', foo''): a prime is not a word
         delimiter, so a keyword never matches the head of a primed identifier. -->
    <keywords casesensitive="1" weakDeliminators="'"/>
  </general>
</language>
