name:               site
version:            0.1.0.0
build-type:         Simple
cabal-version:      >= 1.10

library
  hs-source-dirs:   src
  exposed-modules:  Publications
                  , Talks
                  , Courses
                  , Posts
                  , Prose
  build-depends:    base == 4.*
                  , bibtex == 0.1.0.7
                  , containers
                  , parsec
                  , pandoc
                  , pandoc-crossref
                  , pandoc-types
                  , skylighting
                  , skylighting-core
                  , text
                  , time
                  , yaml
                  , aeson
                  , vector
  default-language: Haskell2010

executable site
  main-is:          site.hs
  build-depends:    base == 4.*
                  , site
                  , hakyll == 4.16.*
                  , hakyll-alectryon
                  , pandoc
                  , pandoc-types
                  , skylighting
                  , filepath
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  default-language: Haskell2010

test-suite site-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:    base == 4.*
                  , site
                  , bibtex == 0.1.0.7
                  , pandoc-types
                  , tasty
                  , tasty-hunit
                  , text
                  , time
                  , aeson
                  , vector
  default-language: Haskell2010
